#spl .lg{position:relative;width:min(80vw,340px);aspect-ratio:356/197;animation:splg 1s ease 1s}#spl .lg img{position:absolute;left:0;top:0;width:100%;opacity:0;animation:splin .7s cubic-bezier(.2,1.5,.4,1) forwards}#spl .lg img:nth-child(1){--x:-70px;--r:-10deg;animation-delay:.1s}#spl .lg img:nth-child(2){--x:0px;--r:0deg;animation-delay:.35s}#spl .lg img:nth-child(3){--x:70px;--r:10deg;animation-delay:.6s}
